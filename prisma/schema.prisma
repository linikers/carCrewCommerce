// Prisma Schema — CarCrew Commerce
// PostgreSQL via Vercel Postgres (Neon)
// URL configurada em prisma.config.ts (não mais no schema)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth v4 — PrismaAdapter models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// CarCrew — Models de negócio
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  senha         String?
  admin         Boolean   @default(false)
  criadoEm      DateTime  @default(now()) @map("criado_em")

  accounts Account[]
  sessions Session[]
  pedidos  Pedido[]

  @@map("users")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nome      String
  icone     String   @default("🔧")
  descricao String?
  ordem     Int      @default(0)
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id           Int       @id @default(autoincrement())
  nome         String
  /// Código interno da peça (6.7/6.7-admin). A operação não identifica peça
  /// por nome — "compressor 444" tem cinco variações.
  sku          String?   @unique

  // Fiscal (#78) — sem NCM e CFOP não existe nota. Nulo até alguém preencher.
  ncm          String?
  cest         String?
  cfop         String?
  /// 0=nacional, 1=estrangeira (origem da mercadoria, tabela da SEFAZ)
  origem       Int?      @default(0)
  cstIcms      String?   @map("cst_icms")
  /// UN, CX, KG, M, PC…
  unidade      String?   @default("UN")
  descricao    String?
  /// Preço de referência (o praticado no marketplace). Nulo = usa `preco`.
  precoBase    Float?    @map("preco_base")
  /// Preço de venda NO SITE, já com a política do canal aplicada.
  preco        Float
  /// Custo unitário da peça (quanto o dono pagou). Nulo = desconhecido — nunca
  /// zero, porque zero finge margem de 100%. Vira snapshot em
  /// `PedidoItem.custoUnitario` no fechamento da venda.
  custo        Float?
  imgUrl       String?
  imagens      String[]  @default([])
  categorySlug String    @map("category_slug")
  parcelamento Int       @default(1)
  estoque      Int       @default(0)

  /// Desconto à vista na loja, em %. 0 = sem desconto. Aplicado em card, PDP,
  /// carrinho e no preço gravado do pedido (o servidor recalcula).
  descontoPercent Float @default(0) @map("desconto_percent")
  veiculos     String[]
  ativo        Boolean   @default(true)
  // 1.5: curadoria da home — antes era o catálogo inteiro em ordem de id.
  destaque     Boolean   @default(false)
  ordem        Int       @default(0)
  criadoEm     DateTime  @default(now()) @map("criado_em")

  // Medidas para cálculo de frete (em centímetros e gramas)
  peso         Float?    // gramas
  altura       Float?    // cm
  largura      Float?    // cm
  profundidade Float?    // cm

  categoria Categoria @relation(fields: [categorySlug], references: [slug])

  itensPedido PedidoItem[]
  movimentos  EstoqueMovimento[]
  precosCanal PrecoCanal[]

  @@map("produtos")
}

/// 7.1: captura de e-mail/telefone. Todo tráfego que não comprava na hora era
/// perdido — inclusive o interesse no pré-lançamento.
model Lead {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  telefone      String?
  origem        String   @default("site")
  /// Texto do consentimento aceito no momento (LGPD): guarda o que a pessoa leu
  consentimento String?  @map("consentimento")
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("leads")
}

/// Dados fiscais da empresa — #78.
///
/// Existir aqui **não emite nota**: é cadastro. A emissão é decidida por canal
/// (site / marketplace) e depende do certificado A1, que entra no #79.
/// O .pfx nunca vai para o banco nem para o repo: aqui fica só nome e validade.
model EmpresaFiscal {
  id String @id @default("unica")

  razaoSocial  String  @map("razao_social")
  nomeFantasia String? @map("nome_fantasia")
  /// Nulo enquanto a empresa não informar — o fiscal cobra no momento de emitir
  cnpj         String? @unique
  ie           String?
  im           String?
  /// 1 = Simples Nacional, 2 = Simples (excesso), 3 = Regime Normal
  crt          Int     @default(1)
  cnae         String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  telefone    String?
  email       String?

  /// logo em JPG (data URI base64) — usado no PDF da OS
  logo        String?

  /// redes sociais e site: { instagram, facebook, tiktok, youtube, site }
  redesSociais Json? @map("redes_sociais")

  /// homologacao | producao
  ambiente      String  @default("homologacao")
  serie         Int     @default(1)
  proximoNumero Int     @default(1) @map("proximo_numero")

  /// metadados do certificado A1 (o arquivo vive no segredo do deploy)
  certificadoNome     String?   @map("certificado_nome")
  certificadoValidade DateTime? @map("certificado_validade")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("empresa_fiscal")
}

/// Ordem de serviço da oficina — #80.
///
/// Oficina não vende só peça: entra veículo, diagnóstico, serviço e prazo. Sem
/// OS o orçamento é conversa no WhatsApp e o histórico do carro se perde.
model OrdemServico {
  id String @id @default(cuid())

  clienteNome      String  @map("cliente_nome")
  clienteTelefone  String? @map("cliente_telefone")
  clienteEmail     String? @map("cliente_email")
  clienteDocumento String? @map("cliente_documento")

  veiculo String
  placa   String?
  km      Int?

  descricaoProblema String  @map("descricao_problema")
  observacoes       String?

  /// abre | orcamento | aprovada | aguardando_peca | execucao | concluida | entregue | cancelada
  status String @default("aberta")

  totalPecas    Float @default(0) @map("total_pecas")
  totalServicos Float @default(0) @map("total_servicos")
  total         Float @default(0)

  prazo DateTime?

  /// link público do orçamento: o cliente abre sem login e aprova/recusa
  tokenPublico String? @unique @map("token_publico")
  aprovadoEm   DateTime? @map("aprovado_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  itens OsItem[]

  @@index([status])
  @@index([clienteTelefone])
  @@map("os_ordens")
}

model OsItem {
  id        String @id @default(cuid())
  ordemId   String @map("ordem_id")
  tipo      String
  descricao String
  produtoId Int?   @map("produto_id")
  /// de onde veio a peça: catalogo (baixa estoque) | externa (comprada fora)
  origem    String?
  /// custo do item (peça comprada fora / serviço de terceiro). Nulo = desconhecido
  custo     Float?
  /// quem executou o serviço de terceiro
  terceiro  String?
  quantidade Int
  valorUnit  Float @map("valor_unit")
  total      Float

  ordem OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId])
  @@map("os_itens")
}

/// Certificado A1 da empresa (#78/#79).
///
/// O .pfx fica **cifrado** (AES-256-GCM) no banco, com a senha cifrada junto —
/// o arquivo nunca vai para o repo nem para o disco do servidor. A chave de
/// cifra vem de `CONFIG_SECRET_KEY` (env).
model CertificadoDigital {
  id String @id @default("unica")

  nomeArquivo String @map("nome_arquivo")
  /// base64 do blob cifrado (iv + tag + ciphertext)
  conteudo    String
  /// senha do .pfx, cifrada com a mesma chave
  senha       String

  titular  String?
  cnpj     String?
  emissor  String?
  validoDe DateTime? @map("valido_de")
  validoAte DateTime? @map("valido_ate")

  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("certificado_digital")
}

/// Credenciais de canal de venda (Shopee, Mercado Livre…).
///
/// Guarda o que a integração precisa para autenticar, cifrado. O `canal` é a
/// chave: um registro por marketplace. Sincronizar catálogo/pedido é o #83/#84
/// — aqui é só o cadastro para o dia em que a integração rodar.
model CredencialCanal {
  id String @id @default(cuid())

  canal String @unique
  /// JSON cifrado com os campos do canal
  dados String
  ativo Boolean @default(false)

  conectadoEm DateTime? @map("conectado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("credencial_canal")
}

model Configuracao {
  chave String @id
  valor Json

  @@map("configuracoes")
}

/// 7.7: login sem limite de tentativas. Contador por conta (o callback do
/// NextAuth não recebe o IP), com janela deslizante de 15 minutos.
model TentativaLogin {
  chave        String   @id
  falhas       Int      @default(0)
  primeiraEm   DateTime @default(now()) @map("primeira_em")
  bloqueadoAte DateTime? @map("bloqueado_ate")

  @@map("tentativas_login")
}

/// 7.8: nenhum registro de quem mudou o quê. Preço alterado errado, produto
/// apagado, status trocado — sem prova e sem desfazer.
model Auditoria {
  id        Int      @id @default(autoincrement())
  entidade  String
  entidadeId String  @map("entidade_id")
  acao      String
  antes     Json?
  depois    Json?
  userId    String?  @map("user_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([entidade, entidadeId])
  @@map("auditoria")
}

model Banner {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String?
  imgDesktop String?
  imgMobile  String?
  link       String?
  corFundo   String   @default("#1A1A1A") @map("cor_fundo")
  corTexto   String   @default("#ffffff") @map("cor_texto")
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)

  @@map("banners")
}

model Pedido {
  id        String   @id @default(cuid())
  // Pedido de visitante não tem usuário: o checkout manda "guest" e a FK
  // derrubava o pedido inteiro (P2003). Os dados de contato ficam no próprio
  // pedido; `userId` só é preenchido quando o cliente está logado.
  userId    String?  @map("user_id")
  /// @deprecated legado: pedidos antigos guardavam o carrinho em JSON. Os
  /// novos gravam em `pedido_itens` (item relacional, com SKU e preço do
  /// momento da compra). Mantido só para leitura de pedido antigo.
  items     Json?
  itens     PedidoItem[]
  total     Float
  status    String   @default("pendente")
  /// canal de venda: site | shopee | mercado_livre | manual | pdv
  canal     String   @default("site")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 6.1: o checkout já coletava endereço, frete e telefone — e o pedido
  // nascia sem nada disso. Sem endereço não existe expedição; sem frete não
  // existe conferência de etiqueta.
  enderecoEntrega Json?   @map("endereco_entrega")
  frete           Float?  @map("frete")
  clienteNome      String? @map("cliente_nome")
  clienteTelefone  String? @map("cliente_telefone")
  clienteEmail     String? @map("cliente_email")
  // 5.5: sem CPF/CNPJ o pedido não vira nota fiscal depois (6.12).
  clienteDocumento String? @map("cliente_documento")

  // ── Custo da venda (#191) ─────────────────────────────────────────────
  // Guarda as ENTRADAS; `resultado` é materializado por `recalcularVenda`
  // (mesma fórmula do domínio), senão o relatório teria uma conta e a tela
  // outra.
  /// comissão da plataforma em R$ (marketplace: sale_fee real do pedido)
  comissao          Float?
  /// % aplicado, para auditar o cálculo depois
  comissaoPercent   Float?   @map("comissao_percent")
  /// frete que o VENDEDOR pagou (diferente de `frete`, que é o cobrado)
  freteVendedor     Float?   @map("frete_vendedor")
  imposto           Float?
  impostoPercent    Float?   @map("imposto_percent")
  embalagem         Float?
  /// publicidade atribuída a esta venda
  ads               Float    @default(0)
  /// manual | rateio | api — rateio não sobrescreve manual
  adsOrigem         String   @default("manual") @map("ads_origem")
  /// manual | calculado | importado — de onde vieram os custos
  custosOrigem      String   @default("manual") @map("custos_origem")
  /// data da venda no canal (histórico importado pode diferir de createdAt)
  vendaEm           DateTime? @map("venda_em")
  /// id do pedido no marketplace — chave de deduplicação da importação
  canalPedidoId     String?  @map("canal_pedido_id")
  /// resultado materializado = receita − custos − ads
  resultado         Float?
  margemPercent     Float?   @map("margem_percent")

  @@unique([canal, canalPedidoId])

  user User? @relation(fields: [userId], references: [id])

  @@map("pedidos")
}

/// Item do pedido — #72.
///
/// Antes: o carrinho inteiro era um JSON em `pedidos.items`. Consequências:
/// não existe consulta "quantas unidades do SKU X vendi", o estoque não sabe
/// de qual item baixou, o picking não tem linha para conferir e a nota fiscal
/// não tem item para escriturar.
///
/// Guarda **foto** do produto (nome, SKU, preço) no momento da compra: mudar
/// o preço do catálogo depois não reescreve o que o cliente pagou.
/// Movimento de estoque — #73.
///
/// `Produto.estoque` era um número digitado à mão: sem histórico, sem quem
/// mexeu, sem como reconciliar quando a contagem física divergisse. Cada
/// entrada, saída, ajuste ou estorno vira uma linha aqui; o saldo do produto
/// passa a ser a soma dos movimentos (mantida em `Produto.estoque` para não
/// somar a tabela inteira em toda listagem).
/// Preço diferente por canal, por item (#preco-canal).
/// Nada aqui = usa a política global do canal.
model PrecoCanal {
  id         String   @id @default(cuid())
  produtoId  Int      @map("produto_id")
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  canal      String
  /// % sobre o preço base. Null = não sobrescreve
  percentual Float?
  /// preço fixo no canal. Null = calcula pelo percentual
  precoFixo  Float?  @map("preco_fixo")
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([produtoId, canal])
  @@map("preco_canal")
}

model EstoqueMovimento {
  id        String   @id @default(cuid())
  produtoId Int      @map("produto_id")
  tipo      String
  /// positivo = entra, negativo = sai. Zero só em ajuste de conferência.
  quantidade Int
  /// saldo do produto depois deste movimento
  saldoDepois Int   @map("saldo_depois")
  motivo     String
  /// de onde veio: pedido, manual, compra, estorno, conferencia
  origem     String
  pedidoId   String?  @map("pedido_id")
  usuarioId  String?  @map("usuario_id")
  criadoEm   DateTime @default(now()) @map("criado_em")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm])
  @@index([pedidoId])
  @@map("estoque_movimentos")
}

model PedidoItem {
  id        String  @id @default(cuid())
  pedidoId  String  @map("pedido_id")
  produtoId Int?    @map("produto_id")

  nome       String
  sku        String?
  preco      Float
  quantidade Int
  /// preco * quantidade, calculado na gravação
  total      Float
  /// Custo da peça no momento da venda (foto de `Produto.custo`). Mudar o
  /// custo no cadastro depois não reescreve o resultado de venda antiga.
  custoUnitario Float? @map("custo_unitario")

  criadoEm DateTime @default(now()) @map("criado_em")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("pedido_itens")
}
